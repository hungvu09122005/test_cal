{
  "name": "test_cal",
  "version": "1.0.0",
  "description": "Bộ tài liệu và kịch bản kiểm thử cho ứng dụng Web **[Basic Calculator](https://testsheepnz.github.io/BasicCalculator.html)** theo tiêu chuẩn kiểm thử phần mềm chuyên nghiệp.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npx playwright test tests/scripts/build-5.spec.js tests/scripts/build-8.spec.js",
    "test:build5": "npx playwright test tests/scripts/build-5.spec.js",
    "test:build8": "npx playwright test tests/scripts/build-8.spec.js",
    "test:prototype": "npx playwright test tests/scripts/TC-*.spec.js",
    "test:all": "npx playwright test",
    "test:headed": "npx playwright test tests/scripts/build-5.spec.js tests/scripts/build-8.spec.js --headed",
    "test:report": "npx playwright show-report tests/test-reports/html-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungvu09122005/test_cal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hungvu09122005/test_cal/issues"
  },
  "homepage": "https://github.com/hungvu09122005/test_cal#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
